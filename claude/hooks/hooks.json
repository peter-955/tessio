{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_tessio_tessio__record_case_result",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/upload_screenshots.py\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "mcp__plugin_tessio_tessio__finish_run",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/upload_run_log.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
