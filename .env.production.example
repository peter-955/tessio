IMAGE_REGISTRY=ghcr.io/your-github-owner
TESSIO_IMAGE_TAG=main
TESSIO_DOMAIN=tessio.example.com
STORAGE_DOMAIN=storage.tessio.example.com

POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql+asyncpg://tessio:change-me-postgres-password@postgres:5432/tessio
REDIS_URL=redis://redis:6379

TESSIO_ENCRYPTION_KEY=
TESSIO_ENCRYPTION_KEY_ID=1
TESSIO_PREVIOUS_ENCRYPTION_KEYS=
SESSION_COOKIE_SECURE=true
CLIENT_URL=https://tessio.example.com
# The plugin marketplace shown on the Connect Claude page is set at client image build time: NEXT_PUBLIC_TESSIO_PLUGIN_MARKETPLACE (GitHub repository variable TESSIO_PLUGIN_MARKETPLACE).

S3_ENDPOINT_URL=http://rustfs:9000
S3_PUBLIC_ENDPOINT_URL=https://storage.tessio.example.com
S3_REGION=eu-west-3
S3_BUCKET=tessio
S3_ACCESS_KEY_ID=change-me-storage-access-key
S3_SECRET_ACCESS_KEY=change-me-storage-secret-key

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
MAIL_SENDER=Tessio <no-reply@tessio.example.com>

LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
BULL_BOARD_USER=tessio
BULL_BOARD_PASSWORD=change-me-bull-board-password
